# Postgres local com a base completa (destino do ETL) — ver docs/decisoes/0004
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/postgres

# Supabase com a amostra, jobs e resultados — valores fictícios
# Usar o Session Pooler (IPv4), não a conexão direta (só IPv6) — ver docs/decisoes/0010
# Na senha, codificar % e / como %25 e %2F
SUPABASE_DATABASE_URL=postgresql://postgres.seu-projeto:senha@aws-0-regiao.pooler.supabase.com:5432/postgres?sslmode=require

# Chave da API do Portal da Transparência (header chave-api-dados); usada pelo worker nas bases do Portal
PORTAL_API_KEY=sua-chave-aqui
# Abaixo do limite diurno do Portal (90 por minuto) — ver docs/decisoes/0014
PORTAL_API_REQUESTS_PER_MINUTE=80

# Worker do modo exploration (ver docs/contratos.md)
EXPLORATION_MAX_ROWS=50000
EXPLORATION_MIN_ROWS=100
EXPLORATION_RETENTION_HOURS=24
EXPLORATION_STALE_MINUTES=30
# Teto de registros baixados da API do Portal por job
EXPLORATION_PORTAL_MAX_ROWS=10000
